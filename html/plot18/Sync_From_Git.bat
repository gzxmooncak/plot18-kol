@echo off
cls
echo ==========================================
echo       GitHub 强制同步工具 (安全模式)
echo ==========================================
echo.

:: 第一步：获取更新
echo [步骤 1/3] 准备从 GitHub 获取远程分支状态...
echo 提示：此操作仅下载索引，不会改动你的本地文件。
pause
git fetch origin main
if %ERRORLEVEL% NEQ 0 (
    echo [错误] 无法连接到 GitHub，请检查网络。
    pause
    exit /b
)

:: 第二步：强制覆盖（高风险）
echo.
echo ------------------------------------------
echo [警告] 即将执行：强制重置 (git reset --hard)
echo 风险：本地所有【未提交】的改动将被【永久抹除】！
echo       代码将变得和 GitHub 上的 main 分支完全一模一样。
echo ------------------------------------------
echo 如果确定要覆盖本地代码，请按 [回车] 继续...
pause
git reset --hard origin/main

:: 第三步：清理垃圾（高风险）
echo.
echo ------------------------------------------
echo [警告] 即将执行：清理未追踪文件 (git clean -fd)
echo 风险：本地文件夹中【不在 Git 记录里】的新文件/文件夹将被【直接删除】！
echo       (例如你手动新建但没 git add 的临时文件)
echo ------------------------------------------
echo 如果确定要删除这些多余文件，请按 [回车] 继续...
pause
git clean -fd

echo.
echo ==========================================
echo 恭喜！同步操作已安全完成。
echo 本地路径: %CD%
echo ==========================================
pause